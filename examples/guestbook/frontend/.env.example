# Canopy public RPC (height, accounts, fees, tx submission)
VITE_CANOPY_RPC_URL=http://localhost:50002
# Optional second node for NodePool failover; leave unset for a single local node
# VITE_CANOPY_RPC_URL_FALLBACK=http://localhost:60002
# The go-plugin's own HTTP server, which serves the guestbook feed
VITE_GUESTBOOK_RPC_URL=http://localhost:50010
# Must match the node: `networkID` in ~/.canopy/config.json, `chainId` in plugin/go/chain.json
VITE_CANOPY_NETWORK_ID=1
VITE_CANOPY_CHAIN_ID=1
# Fallback fee in uCNPY, used only if the fee-params query fails
VITE_CANOPY_FEE=10000
# UI poll interval in milliseconds
VITE_POLL_INTERVAL_MS=3000
